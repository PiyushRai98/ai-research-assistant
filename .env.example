# ==========================================================================
# AI Research Assistant - Environment Configuration
# Copy this file to `.env` and adjust values. NEVER commit `.env`.
# All variables are optional; sensible defaults are applied in code.
# ==========================================================================

# ---- Application ----
APP_NAME="AI Research Assistant"
APP_ENV=development            # development | staging | production
APP_DEBUG=true
APP_LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
APP_HOST=0.0.0.0
APP_PORT=8000

# ---- API / Frontend wiring ----
API_BASE_URL=http://localhost:8000

# ---- Storage paths (relative to project root or absolute) ----
STORAGE_UPLOAD_DIR=storage/uploads
STORAGE_VECTORSTORE_DIR=storage/vectorstore
STORAGE_DATABASE_PATH=storage/database/metadata.db
STORAGE_LOG_DIR=storage/logs

# ---- Upload limits ----
UPLOAD_MAX_FILE_MB=50
UPLOAD_ALLOWED_MIME=application/pdf

# ---- Chunking ----
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ---- Embeddings ----
# Options: BAAI/bge-small-en-v1.5 | sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu           # cpu | cuda
EMBEDDING_BATCH_SIZE=32

# ---- Retrieval ----
RETRIEVAL_TOP_K=5
RETRIEVAL_STRATEGY=mmr         # similarity | mmr
RETRIEVAL_MMR_LAMBDA=0.5
RETRIEVAL_SCORE_THRESHOLD=0.0

# ---- LLM ----
# Provider: granite | llama | openai_compatible | echo (offline/test fallback)
LLM_PROVIDER=granite
LLM_MODEL=ibm-granite/granite-3.0-8b-instruct
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60
# Endpoint + key for OpenAI-compatible / hosted inference (Ollama, vLLM, watsonx proxy, etc.)
LLM_API_BASE=http://localhost:11434/v1
LLM_API_KEY=

# ---- Authentication (optional local login) ----
AUTH_ENABLED=false
AUTH_SECRET_KEY=change-me-in-production-use-a-long-random-string
AUTH_TOKEN_TTL_MINUTES=720

# ---- Caching (optional) ----
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
